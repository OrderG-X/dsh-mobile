# 这个仓库的发版设置（工作流读它；其余文件由 dsh-plugins/_ci/sync.sh 同步）
PKG_DIR=.
ASSETS=dsh-mobile.tgz
TEST_CMD=npm test
# 测试也在 Windows 上跑一遍
TEST_CMD_WINDOWS=npm test
# 日常 DSH 实跑必须通过的系统（空格分隔：macOS Windows）；其余系统的结果只作参考
PLATFORMS=macOS Windows
# 真机端到端：装进全新 DSH，开手机访问、起外网隧道、从公网配对、重启后认回隧道；
# 再用假模型跑任务，看「跑完」「等你批准」两种推送真的发到 Webhook
E2E_CMD=node e2e/e2e-dsh.mjs && node e2e/e2e-push.mjs
